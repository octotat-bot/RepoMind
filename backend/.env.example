# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# ─── Database ─────────────────────────────────────────────────────────────────
# Leave unset to use the zero-setup SQLite file at data/repomind.db.
# Postgres (what docker-compose and any deployment use):
# DATABASE_URL=postgresql+asyncpg://repomind:repomind@localhost:5432/repomind
DB_ECHO=false

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
ALLOW_REGISTRATION=true

# ─── Generation ───────────────────────────────────────────────────────────────
# "ollama" keeps every token on this machine and needs no API key.
# Any other value routes to an OpenAI-compatible endpoint, which is how deployed
# instances run: no free host provides a GPU.
#   groq | openai | openrouter | together | custom
CHAT_PROVIDER=ollama

# Only used when CHAT_PROVIDER is not "ollama".
# Groq is the default because its free tier needs no credit card.
# CHAT_BASE_URL=https://api.groq.com/openai/v1
# CHAT_MODEL=openai/gpt-oss-20b
# CHAT_API_KEY=gsk_...

# ─── Ollama (used when CHAT_PROVIDER or EMBEDDING_PROVIDER is "ollama") ───────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2

# ─── Embeddings ───────────────────────────────────────────────────────────────
# "ollama"    — the local daemon (best quality, needs Ollama running)
# "fastembed" — ONNX in-process, no daemon and no GPU; for deployed instances
# "hash"      — deterministic offline fallback, poor quality, tests only
EMBEDDING_PROVIDER=ollama

# Only used when EMBEDDING_PROVIDER=fastembed. The dimension must match the
# model, and changing either one requires re-indexing every repository.
#   nomic-ai/nomic-embed-text-v1.5-Q  -> 768 dims, ~130 MB  (matches Ollama)
#   BAAI/bge-small-en-v1.5            -> 384 dims,  ~67 MB  (fits 512 MB hosts)
# FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# ONNX working memory scales with batch size AND thread count. On a 512 MB
# host use EMBEDDING_BATCH_SIZE=4 and EMBEDDING_THREADS=1, which drops peak
# usage from ~458 MB to ~348 MB. 0 lets the library decide.
EMBEDDING_THREADS=0

# ─── Storage ──────────────────────────────────────────────────────────────────
# Turn on for hosts that wipe the disk between restarts (Render free, Fly, etc).
# Indexing then also stores vectors and file text in the database so the FAISS
# index and working tree can be rebuilt on demand instead of re-indexed.
EPHEMERAL_FILESYSTEM=false

# ─── Ingestion ────────────────────────────────────────────────────────────────
CLONE_DEPTH=1
CLONE_TIMEOUT_SECONDS=600
MAX_CONCURRENT_INDEXING_JOBS=2
# Optional: raises the GitHub metadata rate limit from 60/hr to 5000/hr
# GITHUB_TOKEN=ghp_xxx

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Must list the frontend origin exactly, including scheme and port.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
