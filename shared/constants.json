{
  "$comment": "Single source of truth for ingestion + display rules. Imported by the Python backend (shared_config.py) and the Next.js frontend (@/lib/constants).",
  "chunking": {
    "targetTokens": 400,
    "minTokens": 60,
    "maxTokens": 500,
    "overlapTokens": 50,
    "charsPerToken": 4
  },
  "retrieval": {
    "topK": 6,
    "candidateMultiplier": 4,
    "minSimilarity": 0.15,
    "maxContextTokens": 3200
  },
  "limits": {
    "maxFileBytes": 400000,
    "maxFilesPerRepo": 4000,
    "maxRepoBytes": 300000000,
    "maxLineLength": 2000
  },
  "languages": {
    ".ts": "typescript",
    ".tsx": "tsx",
    ".js": "javascript",
    ".jsx": "jsx",
    ".mjs": "javascript",
    ".cjs": "javascript",
    ".py": "python",
    ".java": "java",
    ".cpp": "cpp",
    ".cc": "cpp",
    ".cxx": "cpp",
    ".hpp": "cpp",
    ".c": "c",
    ".h": "c",
    ".md": "markdown",
    ".mdx": "markdown",
    ".json": "json",
    ".html": "html",
    ".htm": "html",
    ".css": "css",
    ".scss": "css",
    ".sass": "css",
    ".go": "go",
    ".rs": "rust",
    ".rb": "ruby",
    ".php": "php",
    ".sh": "shell",
    ".yml": "yaml",
    ".yaml": "yaml",
    ".sql": "sql",
    ".toml": "toml"
  },
  "primaryLanguages": [
    "typescript",
    "tsx",
    "javascript",
    "jsx",
    "python",
    "java",
    "cpp",
    "c",
    "go",
    "rust"
  ],
  "ignoredDirectories": [
    ".git",
    ".hg",
    ".svn",
    "node_modules",
    "bower_components",
    "vendor",
    "dist",
    "build",
    "out",
    "target",
    ".next",
    ".nuxt",
    ".turbo",
    ".vercel",
    ".svelte-kit",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".venv",
    "venv",
    "env",
    "site-packages",
    ".idea",
    ".vscode",
    "coverage",
    ".nyc_output",
    "tmp",
    "temp",
    ".cache",
    "logs",
    "migrations",
    "__snapshots__",
    ".gradle",
    "Pods",
    "DerivedData"
  ],
  "ignoredFileGlobs": [
    "*.min.js",
    "*.min.css",
    "*.map",
    "*.lock",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "poetry.lock",
    "Cargo.lock",
    "*.bundle.js",
    "*.chunk.js",
    "*.d.ts",
    "*.snap",
    "*.pb.go",
    "*_pb2.py"
  ],
  "binaryExtensions": [
    ".png", ".jpg", ".jpeg", ".gif", ".bmp", ".ico", ".webp", ".avif", ".svg",
    ".pdf", ".zip", ".tar", ".gz", ".bz2", ".xz", ".7z", ".rar",
    ".mp3", ".mp4", ".wav", ".avi", ".mov", ".mkv", ".webm", ".flac",
    ".woff", ".woff2", ".ttf", ".eot", ".otf",
    ".so", ".dylib", ".dll", ".exe", ".bin", ".o", ".a", ".class", ".jar",
    ".pyc", ".pyo", ".pyd", ".wasm", ".db", ".sqlite", ".sqlite3",
    ".psd", ".ai", ".sketch", ".fig", ".parquet", ".npy", ".pkl", ".h5"
  ],
  "languageColors": {
    "typescript": "#3178C6",
    "tsx": "#3178C6",
    "javascript": "#F7DF1E",
    "jsx": "#F7DF1E",
    "python": "#3776AB",
    "java": "#EA2D2E",
    "cpp": "#00599C",
    "c": "#A8B9CC",
    "go": "#00ADD8",
    "rust": "#DEA584",
    "ruby": "#CC342D",
    "php": "#777BB4",
    "markdown": "#888888",
    "json": "#8BC34A",
    "html": "#E34F26",
    "css": "#1572B6",
    "shell": "#89E051",
    "yaml": "#CB171E",
    "sql": "#E38C00",
    "toml": "#9C4221"
  },
  "techStackSignals": {
    "package.json": "Node.js",
    "next.config.js": "Next.js",
    "next.config.mjs": "Next.js",
    "next.config.ts": "Next.js",
    "nuxt.config.ts": "Nuxt",
    "vite.config.js": "Vite",
    "vite.config.ts": "Vite",
    "webpack.config.js": "Webpack",
    "tailwind.config.js": "Tailwind CSS",
