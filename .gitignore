# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
.next/
.next-build/
out/
.turbo/
.vercel/
*.tsbuildinfo

# ── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Runtime artefacts ────────────────────────────────────────────────────────
# Cloned repositories, the SQLite database and FAISS indexes are all rebuildable
# from an import, so none of it belongs in version control.
data/
faiss/indexes/*
!faiss/indexes/.gitkeep
*.db
*.sqlite3
*.faiss

# Vendored copy of shared/constants.json (regenerated by npm predev/prebuild)
frontend/src/lib/shared-constants.json

# Screenshot scratch directory. The published copies live in docs/screenshots/.
frontend/scripts/.screenshots/

# PID files and service logs written by scripts/start.sh
.run/

# Prisma generated client
database/generated/

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
!.vscode/extensions.json

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
